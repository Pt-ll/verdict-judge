{
  "name": "verdict-judge",
  "displayName": "Verdict · VSCode 评测系统",
  "description": "在编辑器内完成出题、造数据、评测、重测、榜单与导出的本地评测系统。完全离线、零运行时依赖。",
  "version": "0.1.3",
  "publisher": "YuChenZhong",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pt-ll/verdict-judge.git"
  },
  "bugs": {
    "url": "https://github.com/Pt-ll/verdict-judge/issues"
  },
  "galleryBanner": {
    "color": "#1f3e8c",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "packageManager": "pnpm@11.26.0",
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "judge",
    "评测",
    "oi",
    "icpc",
    "competitive-programming",
    "testlib",
    "offline"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --testTimeout=30000",
    "test:watch": "vitest --testTimeout=30000",
    "test:integration": "node ./test/runTest.js",
    "package": "node scripts/package.js",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "verdict",
          "title": "Verdict",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "verdict": [
        {
          "type": "webview",
          "id": "verdict.controlPanel",
          "name": "评测面板",
          "contextualTitle": "Verdict"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "verdict.checkEnv",
          "when": "view == verdict.controlPanel",
          "group": "navigation@1"
        }
      ]
    },
    "commands": [
      {
        "command": "verdict.checkEnv",
        "title": "Verdict: 检查环境"
      },
      {
        "command": "verdict.judgeCurrent",
        "title": "Verdict: 评测当前文件"
      },
      {
        "command": "verdict.cancel",
        "title": "Verdict: 取消当前任务"
      },
      {
        "command": "verdict.addTests",
        "title": "Verdict: 导入测试点"
      },
      {
        "command": "verdict.configureSubtasks",
        "title": "Verdict: 配置子任务"
      },
      {
        "command": "verdict.setLimits",
        "title": "Verdict: 设置限制"
      },
      {
        "command": "verdict.showDiff",
        "title": "Verdict: 对比输出"
      },
      {
        "command": "verdict.debugCase",
        "title": "Verdict: 调试首测点"
      },
      {
        "command": "verdict.newContest",
        "title": "Verdict: 新建比赛"
      },
      {
        "command": "verdict.switchContest",
        "title": "Verdict: 切换比赛"
      },
      {
        "command": "verdict.newProblem",
        "title": "Verdict: 新建题目"
      },
      {
        "command": "verdict.deleteProblem",
        "title": "Verdict: 删除题目"
      },
      {
        "command": "verdict.addProblemToContest",
        "title": "Verdict: 把题目加入当前比赛"
      },
      {
        "command": "verdict.removeProblemFromContest",
        "title": "Verdict: 把题目移出当前比赛"
      },
      {
        "command": "verdict.judgeAll",
        "title": "Verdict: 评测全部"
      },
      {
        "command": "verdict.rejudge",
        "title": "Verdict: 重测"
      },
      {
        "command": "verdict.showStandings",
        "title": "Verdict: 显示榜单"
      },
      {
        "command": "verdict.exportHtml",
        "title": "Verdict: 导出 HTML 成绩"
      },
      {
        "command": "verdict.exportProblem",
        "title": "Verdict: 导出题目包"
      },
      {
        "command": "verdict.importProblem",
        "title": "Verdict: 导入题目包"
      }
    ],
    "configuration": {
      "title": "Verdict",
      "properties": {
        "verdict.compiler": {
          "type": "string",
          "default": "",
          "markdownDescription": "指定编译器可执行文件的完整路径。留空则自动探测 `g++` → `clang++` → `cl`。"
        },
        "verdict.flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-O2",
            "-std=c++17"
          ],
          "description": "编译参数。"
        },
        "verdict.debug": {
          "type": "boolean",
          "default": false,
          "description": "在输出通道中打印调试日志。"
        },
        "verdict.defaultTimeMs": {
          "type": "number",
          "default": 1000,
          "description": "默认时间限制（毫秒）。"
        },
        "verdict.defaultMemoryMb": {
          "type": "number",
          "default": 256,
          "description": "默认内存限制（MB），同时作为栈上限。"
        },
        "verdict.outputLimitKb": {
          "type": "number",
          "default": 4096,
          "description": "输出上限（KB），超过判 OLE。"
        },
        "verdict.comparator": {
          "type": "string",
          "enum": [
            "default",
            "line",
            "real"
          ],
          "default": "default",
          "markdownDescription": "评测当前文件时使用的比较方式。M2 引入题目包后由 `problem.json` 覆盖。"
        },
        "verdict.realAbsEps": {
          "type": "number",
          "default": 0.000001,
          "description": "real 比较的绝对误差。"
        },
        "verdict.realRelEps": {
          "type": "number",
          "default": 0.000001,
          "description": "real 比较的相对误差。"
        },
        "verdict.autoDiff": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "出现 WA / PC 时自动打开「实际输出 ↔ 标准答案」的原生 diff（SPEC §4.5）。"
        },
        "verdict.testlibPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "testlib.h 所在目录或文件。留空则按「题目包 extra/ → 工作区 .verdict/testlib/」的顺序查找（SPEC §6.6）。"
        },
        "verdict.debugStopAtEntry": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "调试时先停在程序入口（方便从第一行单步）。关掉则只在你自己的断点处停。"
        }
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.23.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
